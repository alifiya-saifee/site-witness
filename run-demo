#!/usr/bin/env bash
# Start the helper demo: the hub (control page) and the Diwan Helper, both on this Mac.
# Stop with Ctrl+C. Nothing keeps running afterwards.
set -euo pipefail
cd "$(dirname "$0")"

# settings and keys (NVIDIA_API_KEY etc.) come from .env if you made one; nothing here prints them
if [ -f .env ]; then set -a; . ./.env; set +a; fi

if [ ! -x .venv/bin/python ]; then
  echo "  Setting up (first run only)…"
  python3 -m venv .venv
fi
.venv/bin/pip install -q -r requirements.txt

if [ ! -f samples/records/al-noor-law3-slides.pdf ]; then
  echo "  Making the sample PDFs…"
  .venv/bin/python scripts/make_sample_pdfs.py
fi

.venv/bin/python -m sitewitness.server &
HUB=$!
trap 'kill $HUB ${HELPER:-} 2>/dev/null; echo; echo "  Stopped."' EXIT INT TERM
sleep 1.5
.venv/bin/python helper/diwan_helper.py &
HELPER=$!
wait $HUB
