# The helper demo needs no keys. Keep real secrets out of git: put them in .env (never committed).
SW_PORT=
SW_HOSTS=
# Spoken replies in your own voice (English only), via NVIDIA magpie-tts-zeroshot:
SW_TTS=
NVIDIA_API_KEY=
SW_MAGPIE_FUNCTION_ID=
# Smart plug demo: a TP-Link Tapo P100/P110 on your Wi-Fi (leave empty for the pretend lamp).
# SW_PLUG=tapo, SW_PLUG_HOST = the plug's IP, TAPO_* = your Tapo app login. SW_CAMERA=0 is the Mac camera.
SW_PLUG=
SW_PLUG_HOST=
TAPO_USERNAME=
TAPO_PASSWORD=
SW_CAMERA=
# Understanding sentences with Groq (optional; without it, a simpler word match is used).
# The spoken sentence and the names of your files/apps/devices/websites are sent to Groq; never file contents or addresses.
GROQ_API_KEY=
SW_GROQ_MODEL=
